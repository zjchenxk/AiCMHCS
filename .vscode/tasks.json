{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dart_frog: build",
            "type": "shell",
            "command": "dart",
            "args": [
                "pub",
                "global",
                "run",
                "dart_frog_cli:dart_frog",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "problemMatcher": []
        },
        {
            "label": "fix: build overrides",
            "type": "shell",
            "command": "dart",
            "args": [
                "run",
                "tool/fix_build_overrides.dart"
            ],
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "problemMatcher": []
        },
        {
            "label": "dart_frog: build (with fix)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "dart_frog: build",
                "fix: build overrides"
            ],
            "problemMatcher": []
        }
    ]
}
