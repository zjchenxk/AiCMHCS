{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "client",
            "cwd": "${workspaceFolder}/client",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome",
            // --no-pub：F5 复合启动时 client 自动 pub get 会把 workspace
            // 下 server/ 的临时 lockfile 当 stray 删除，与 dart_frog build
            // 正在使用的 server/pubspec.lock 相撞导致构建崩溃（PathNotFound
            // Exception）；依赖变更时在仓库根手动 flutter pub get 即可
            "args": [
                "--no-pub"
            ]
            // CanvasKit 本地化见 client/web/flutter_bootstrap.js 的
            // canvasKitBaseUrl 配置（JS loader config，比 dart-define 优先）
        },
        {
            "name": "server",
            "cwd": "${workspaceFolder}/server",
            "request": "launch",
            "type": "dart",
            "preLaunchTask": "dart_frog: build (with fix)",
            "program": "${workspaceFolder}/server/build/bin/server.dart"
        }
    ],
    "compounds": [
        {
            "name": "aicmhcs (full stack)",
            "configurations": [
                "server",
                "client"
            ],
            "presentation": {
                "order": 1
            }
        }
    ]
}
